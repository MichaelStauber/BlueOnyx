# configuration bits for mod_rpmize
# syntax:
# <begin [x]section>
# <end [x]section>
#
# x an be $ for a string or % for a hash.
# if a hash is being used, you can add sub-sections with
# <begin sub-section>
# <end sub-section>


<begin $DESCRIPTION>
%package [LABEL]
Group: System Environment/BlueOnyx
Summary: [LABEL] for [VENDOR]-[SERVICE].
[AUTOFILL]
[BUILDARCH]
[PROVIDES]

%description [LABEL]
The [VENDOR]-[SERVICE]-[LABEL] package contains the [LABEL]
information for [VENDOR]-[SERVICE].

<end $DESCRIPTION>

<begin %PREP>
<end %PREP>

<begin %SETUP>
<end %SETUP>

<begin %BUILD>
<end %BUILD>

<begin %INSTALL>
<end %INSTALL>

<begin %FILES>
<begin HEADER>
%files [LABEL]
%defattr(-,root,root)
<end HEADER>

<begin locale>
[AUTOFILL]

<end locale>

<begin glue>
[AUTOFILL]
#/usr/sausalito/bin/addIdentLookups.pl
%attr(0755,-,-) /usr/sausalito/sbin/ftpaccess.pl

<end glue>

<begin ui>
[AUTOFILL]

<end ui>

<begin capstone>
%{RootDir}/capstone/%{Vendor}-%{Service}.cap
[AUTOFILL]

<end capstone>
<end %FILES>

<begin %POST-INSTALL>
<begin HEADER>
%post [LABEL]
<end HEADER>

<begin glue>
# glue post-install

# Fix Proftpd configuration:
sed -i 's|TLSCertificateChainFile\s\+.*|TLSCertificateChainFile       /etc/admserv/certs/nginx_cert_ca_combined|' /etc/proftpd/mod_tls.conf
sed -i 's|TLSRSACertificateFile\s\+.*|TLSRSACertificateFile       /etc/admserv/certs/certificate|' /etc/proftpd/mod_tls.conf
sed -i 's|TLSRSACertificateKeyFile\s\+.*|TLSRSACertificateKeyFile      /etc/admserv/certs/key|' /etc/proftpd/mod_tls.conf
sed -i 's/TLSCipherSuite[[:space:]]*PROFILE=SYSTEM/TLSCipherSuite HIGH:!aNULL:!MD5/' /etc/proftpd/mod_tls.conf
sed -i '/^PROFTPD_OPTIONS/s/"$/ -DTLS"/' /etc/sysconfig/proftpd
sed -i '/PassivePorts/d' /etc/proftpd.conf
sed -i '/<Global>/a\  PassivePorts 49152 65534' /etc/proftpd.conf

# Restart CCEd: 
if [ -d "/usr/sausalito/yumcce" ];then 
  touch /usr/sausalito/yumcce/restart
fi 

<end glue>
<begin ui>
# ui post-install
# this is somewhat nasty, but it always makes sure that there's a
# default .html file in case the browser doesn't specify a locale
if [ x"[DEFLOCALE]" != x ]; then
	for dir in `find [CCEWEB] -type d`; do 
		(cd $dir; 
		if [ x"`ls *.htm[l].[DEFLOCALE] 2> /dev/null`" != x ]; then
			for file in `ls *.htm[l].[DEFLOCALE]`; do
				base=`basename $file .[DEFLOCALE]`
				if [ ! -f $base ]; then
					ln -s $file $base
 				fi
			done
		fi)
	done
fi

<end ui>
<begin locale>
# locale post-install

<end locale>
<end %POST-INSTALL>

<begin %POST-UNINSTALL>
<begin HEADER>
%postun [LABEL]
<end HEADER>

<begin glue>
# glue post-uninstall

<end glue>
<begin ui>
# ui post-uninstall

<end ui>
<begin locale>
