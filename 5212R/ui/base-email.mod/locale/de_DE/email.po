msgid "error_writing_sendmail_mc"
msgstr "Es konnte keine aktualisierte /etc/mail/sendmail.mc geschrieben werden. Bitte überprüfen Sie Ihre sendmail.mc auf Veränderungen. Um auf einen gesicherten Stand zurückzukehren kopieren Sie bitte /usr/sausalito/configs/sendmail/sendmail.mc nach /etc/mail/sendmail.mc um und versuchen Sie es dann erneut."

msgid "maxRecipientsPerMessageField"
msgstr "Maximale Empfänger pro Nachricht"

msgid "maxRecipientsPerMessageField_help"
