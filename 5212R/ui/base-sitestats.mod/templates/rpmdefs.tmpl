# configuration bits for mod_rpmize
# syntax:
# <begin [x]section>
# <end [x]section>
#
# x an be $ for a string or % for a hash.
# if a hash is being used, you can add sub-sections with
# <begin sub-section>
# <end sub-section>


<begin $DESCRIPTION>
%package [LABEL]
Group: System Environment/BlueOnax
Summary: [LABEL] for [VENDOR]-[SERVICE].
[AUTOFILL]
[BUILDARCH]
[PROVIDES]

%description [LABEL]
The [VENDOR]-[SERVICE]-[LABEL] package contains the [LABEL]
information for [VENDOR]-[SERVICE].

<end $DESCRIPTION>

<begin %PREP>
<end %PREP>

<begin %SETUP>
<end %SETUP>

<begin %BUILD>
<end %BUILD>

<begin %INSTALL>
<begin ui>
mkdir -p $RPM_BUILD_ROOT/%{RootDir}/ui/web/%{Vendor}/%{Service}/img
<end ui>
<end %INSTALL>

<begin %FILES>
<begin HEADER>
%files [LABEL]
%defattr(-,root,root)
<end HEADER>

<begin locale>
[AUTOFILL]

<end locale>

<begin glue>
%attr(0755,root,root) /usr/sausalito/sbin/get_web_stats.pl
%attr(0755,root,root) /usr/sausalito/sbin/update_vsite_logrotate.pl
%attr(0755,root,root) /usr/sausalito/sbin/goaccess_init.sh 
%attr(0755,root,root) /usr/sausalito/sbin/goaccess.sh
%attr(0644,root,root) /usr/lib/systemd/system/goaccess.service
%attr(0644,root,root) /usr/sausalito/ui/web/base/sitestats/.htaccess
[AUTOFILL]

<end glue>

<begin ui>
%defattr(-,admserv,root)
%dir /%{RootDir}/ui/web/%{Vendor}/%{Service}/img
[AUTOFILL]

<end ui>

<begin capstone>
%{RootDir}/capstone/%{Vendor}-%{Service}.cap
[AUTOFILL]

<end capstone>
<end %FILES>

<begin %POST-INSTALL>
<begin HEADER>
%post [LABEL]
<end HEADER>

<begin glue>
# glue post-install

test "$1" != "1" || systemctl daemon-reload >/dev/null 2>&1 || :
sed -i 's/^\(\s*fail2ban\s*=\s*\)y/\1n/' /etc/monitorix/monitorix.conf
sed -i 's/^\(\s*mysql\s*=\s*\)y/\1n/' /etc/monitorix/monitorix.conf
systemctl enable goaccess.service >/dev/null 2>&1 || :
systemctl restart goaccess.service >/dev/null 2>&1 || :
systemctl enable monitorix.service >/dev/null 2>&1 || :
systemctl restart monitorix.service >/dev/null 2>&1 || :
/usr/sausalito/sbin/update_vsite_logrotate.pl >/dev/null 2>&1 || :

# Rehash CCEd: 
if [ -d "/usr/sausalito/yumcce" ];then 
  touch /usr/sausalito/yumcce/restart
fi

<end glue>
<begin ui>

# Deprecated:
# /bin/chown admserv.root /%{RootDir}/ui/web/%{Vendor}/%{Service}/img

<end ui>
<begin locale>
# locale post-install

<end locale>
<end %POST-INSTALL>

<begin %POST-UNINSTALL>
<begin HEADER>
%postun [LABEL]
<end HEADER>

<begin glue>
# glue post-uninstall

<end glue>
<begin ui>
# ui post-uninstall

<end ui>
<begin locale>
# locale post-uninstall

<end locale>
<end %POST-UNINSTALL>

