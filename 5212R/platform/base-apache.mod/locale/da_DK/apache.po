msgstr "Alle"

msgid "Options_AllField_help"
msgstr "Alle muligheder undtagen MultiViews. (Standard: Fra)"

msgid "Options_FollowSymLinksField"
msgstr "FollowSymLinks"

msgid "Options_FollowSymLinksField_help"
msgstr "Serveren vil følge symbolske links. (Standard: Til)"

msgid "Options_IncludesField"
msgstr "Inkluderer"

msgid "Options_IncludesField_help"
msgstr "Server-side indeholder er tilladt. (Standard: Til)"

msgid "Options_IndexesField"
msgstr "Indexes"

msgid "Options_IndexesField_help"
msgstr "Hvis en URL, som kort til en mappe der anmodes og der er ingen DirectoryIndex (fx index.html) i denne mappe, så vil serveren returnere en formateret liste af biblioteket. (Standard: Til)"

msgid "Options_MultiViewsField"
msgstr "MultiViews"

msgid "Options_MultiViewsField_help"
msgstr "Indhold forhandlet MultiViews er tilladt. Anvendes til at vise sider på forskellige sprog baseret på browser locales. (Standard: Til)"

msgid "Options_SymLinksIfOwnerMatchField"
msgstr "SymLinksIfOwnerMatch"

msgid "Options_SymLinksIfOwnerMatchField_help"
msgstr "Serveren vil kun følge symbolske links, for hvilken indikativprisen fil eller mappe er ejet af den samme bruger-id, som linket. (Standard: Fra)"

msgid "AllowOverride_AllField"
msgstr "Alle"

msgid "AllowOverride_AllField_help"
msgstr "Når serveren finder en. Htaccess fil er det nødvendigt at vide, hvilke direktiver erklæret i denne fil kan tilsidesætte tidligere adgangsoplysninger. Tikkende denne boks vil gøre det muligt at tilsidesætte alle Apache indstillinger (Dangerous! Standard: Fra)"

msgid "AllowOverride_AuthConfigField"
msgstr "AuthConfig"

msgid "AllowOverride_AuthConfigField_help"
msgstr "Tillad brug af tilladelsen direktiver (AuthDBMGroupFile, AuthDBMUserFile, AuthGroupFile, AuthName, AuthDigestRealmSeed, AuthType, AuthUserFile, Kræv, etc.). (Standard: Til)"

msgid "AllowOverride_FileInfoField"
msgstr "Fileinfo"

msgid "AllowOverride_FileInfoField_help"
msgstr "Tillad brug af direktiverne kontrollerende dokumenttyper (AddEncoding, AddLanguage, AddType, DefaultType, ErrorDocument, LanguagePriority, etc.). (Standard: Fra)"

msgid "AllowOverride_IndexesField"
msgstr "Indexes"

msgid "AllowOverride_IndexesField_help"
msgstr "Tillad brug af direktiverne kontrollerende directory indeksering (AddDescription, AddIcon, AddIconByEncoding, AddIconByType, DefaultIcon, DirectoryIndex, FancyIndexing, HeaderName, IndexIgnore, IndexOptions, ReadmeName, etc.). (Standard: Til)"

msgid "AllowOverride_LimitField"
msgstr "Begræns"

msgid "AllowOverride_LimitField_help"
msgstr "Tillad brug af direktiverne kontrollerende værtsadgang (Tillad, Afvis og Order). (Standard: Til)"

msgid "AllowOverride_OptionsField"
msgstr "Optioner"

msgid "AllowOverride_OptionsField_help"
msgstr "Tillad brug af direktiverne kontrollerer specifikke bibliotek funktioner (Options og XBitHack). (Standard: Fra)"

