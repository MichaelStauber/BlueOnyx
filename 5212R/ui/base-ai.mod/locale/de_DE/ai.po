# Menu items
msgid "ai"
msgstr "KI-Assistent"

msgid "aiDescription"
msgstr "KI-gestützter Serverassistent für Loganalyse und Systemverwaltung."

# Chat
msgid "chat_title"
msgstr "KI-Assistent"

msgid "chat_welcome"
msgstr "Willkommen beim KI-Assistenten. Ich kann bei der Loganalyse, dem Systemstatus und der Serververwaltung helfen. Was möchtest du wissen?"

msgid "chat_placeholder"
msgstr "Gib hier deine Frage ein..."

msgid "chat_send"
msgstr "Senden"

msgid "chat_typing"
msgstr "Die KI denkt nach..."

msgid "chat_no_response"
msgstr "Keine Antwort vom KI-Dienst erhalten. Bitte prüfe die KI-Einstellungen."

msgid "chat_connection_error"
msgstr "Keine Verbindung zum KI-Dienst. Bitte prüfen, ob der Dienst läuft und korrekt konfiguriert ist."

# Settings
msgid "settings_title"
msgstr "KI-Einstellungen"

msgid "settings_save"
msgstr "Einstellungen speichern"

msgid "save_success"
msgstr "Die KI-Einstellungen wurden erfolgreich gespeichert."

msgid "save_error"
msgstr "Das Speichern der KI-Einstellungen ist fehlgeschlagen. Bitte erneut versuchen."

msgid "DIVIDER_PROVIDER"
msgstr "KI-Provider-Konfiguration"

msgid "enabled"
msgstr "KI-Assistent aktivieren"

msgid "enabled_help"
msgstr "Den KI-Assistentendienst aktivieren oder deaktivieren. Wenn deaktiviert, liefern Chat- und API-Endpunkte einen Dienst-nicht-verfügbar-Fehler."

msgid "provider"
msgstr "KI-Provider"

msgid "provider_help"
msgstr "Den zu verwendenden KI-Provider auswählen. OpenAI, OpenRouter oder einen benutzerdefinierten OpenAI-kompatiblen Endpunkt."

msgid "model"
msgstr "Modellname"

msgid "model_help"
msgstr "Die zu verwendende Modellkennung (z. B. gpt-4, claude-3-opus oder ein von deinem Provider unterstützter benutzerdefinierter Modellname)."

msgid "custom_endpoint"
msgstr "API-Endpunkt"

msgid "custom_endpoint_help"
msgstr "Die URL des API-Endpunkts. Für OpenAI: https://api.openai.com/v1. Für OpenRouter: https://openrouter.ai/api/v1. Für benutzerdefinierte Provider den Endpunkt angeben."

msgid "idle_timeout"
msgstr "Leerlauf-Timeout (Minuten)"

msgid "idle_timeout_help"
msgstr "Wie lange der KI-Backend-Dienst nach der letzten Anfrage weiterläuft, bevor er zum Sparen von Ressourcen beendet wird."

msgid "DIVIDER_PROMPT"
msgstr "System-Prompt"

msgid "system_prompt"
msgstr "System-Prompt"

msgid "system_prompt_help"
msgstr "Der System-Prompt, der das Verhalten des KI-Assistenten, die verfügbaren Tools und Einschränkungen definiert. Dieser wird mit jeder Anfrage an den KI-Provider gesendet."

# Error messages
msgid "must_enable_service"
msgstr "Der KI-Assistentendienst ist derzeit deaktiviert. Bitte aktiviere ihn in den KI-Einstellungen, um den Chat zu verwenden."

msgid "service_unavailable"
msgstr "Der KI-Dienst ist derzeit nicht verfügbar. Bitte prüfe die KI-Einstellungsseite, um sicherzustellen, dass der Dienst aktiviert und korrekt konfiguriert ist."

msgid "invalid_session"
msgstr "Ungültige oder abgelaufene KI-Sitzung. Bitte starte eine neue Unterhaltung."

msgid "provider_error"
msgstr "Der KI-Provider hat einen Fehler zurückgegeben. Bitte prüfe deinen API-Schlüssel und die Modellkonfiguration."

msgid "rate_limited"
msgstr "Zu viele Anfragen. Bitte warte einen Moment, bevor du eine weitere Nachricht sendest."

msgid "function_not_found"
msgstr "Die angeforderte KI-Funktion existiert nicht."

msgid "chat_html"
msgstr ""

msgid "chat_html_help"
msgstr ""

msgid "provider_openai"
msgstr "OpenAI"

msgid "provider_openrouter"
msgstr "Openrouter"

msgid "provider_ollama"
msgstr "Ollama Cloud"

msgid "provider_anthropic"
msgstr "Anthropic"

msgid "provider_custom"
msgstr "Custom Provider"

msgid "provider_local"
msgstr "Local Provider"

