include_once('UIExtension.php');

class ShellExtension extends UIExtension {
    function display(&$ServerScriptHelper, &$container, $parameters) {

        $CI =& get_instance();
        $BX_SESSION = $CI->getBX_SESSION();

        $factory = $ServerScriptHelper->getHtmlComponentFactory("base-shell");
        $cce = $ServerScriptHelper->getCceClient();
        $i18n = new I18n("base-shell", $BX_SESSION['loginUser']['localePreference']);

        $Shell_enabled_Map =
            array(
                "0" => "none",
                "1" => "jailed_sftp_scp_rsync",
                "2" => "jailed_shell",
                "3" => "full_shell"
            );

        $access = '1';
        if (isset($parameters["VSITE_OID"])) {
            $feature = $cce->get($parameters["VSITE_OID"], "Shell");
            if ($feature["enabled"] == '0') {
                $access = '0';
            }
            elseif ($feature["enabled"] == '1') {
                unset($Shell_enabled_Map["2"]);
                unset($Shell_enabled_Map["3"]);
            }
            elseif ($feature["enabled"] == '2') {
                unset($Shell_enabled_Map["3"]);
            }
        }

        $defaults = $cce->get($parameters["CCE_SERVICES_OID"], "Shell");
        $pageIds = $container->getPageIds();

        if ($access) {
            $shellEnable = $factory->getMultiChoice("Shell_enabled", array_values($Shell_enabled_Map));
            $shellEnable->setSelected($Shell_enabled_Map[$defaults['enabled']], true);
            $container->addFormField($shellEnable, $factory->getLabel("enableShell"), $pageIds[0]);
        }
        else {
            $word = $Shell_enabled_Map[$defaults['enabled']];
            $nokey_info = $i18n->getClean("[[base-shell.$word]]", false, array());
            $xxx = $factory->getTextField("Shell_enabled_Dummy", $nokey_info, 'r');
            $container->addFormField($xxx, $factory->getLabel("enableShell"), $pageIds[0]);

            $xxx = $factory->getTextField("Shell_enabled", $defaults['enabled'], '');
            $container->addFormField($xxx, $factory->getLabel("enableShell"), $pageIds[0]);
        }
    }

    function handle(&$ServerScriptHelper, &$errors, &$cce_info, &$attributes) {

        $this->attributes = $attributes;

        if (($attributes['Shell_enabled'] != "0") && ($attributes['Shell_enabled'] != "1") && ($attributes['Shell_enabled'] != "2") && ($attributes['Shell_enabled'] != "3")) {
            if (!isset($this->attributes['Shell_enabled'])) {
                $this->attributes['Shell_enabled'] = "0";
            }
            else {
                $Shell_enabled_Map_Reversed =
                    array(
                        "none" => "0",
                        "jailed_sftp_scp_rsync" => "1",
                        "jailed_shell" => "2",
                        "full_shell" => "3"
                    );

                $attributes['Shell_enabled'] = $Shell_enabled_Map_Reversed[$attributes['Shell_enabled']];
            }
        }

        $cce = $ServerScriptHelper->getCceClient();
        $cce->set($cce_info["CCE_OID"], 'Shell', array('enabled' => $attributes['Shell_enabled']));
        $errors = array_merge($errors, $cce->errors());
    }
}
?>
