#!/bin/sh
# Refresh /etc/issue when an address appears or changes (DHCP).
# NM dispatcher: $1 = interface, $2 = action.

case "$2" in
    up|dhcp4-change|dhcp6-change|connectivity-change)
        [ -x /usr/sausalito/sbin/bx_update_issue.sh ] && /usr/sausalito/sbin/bx_update_issue.sh
        ;;
esac
exit 0
