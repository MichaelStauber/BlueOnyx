msgid "DIVIDER_API_KEYS"
msgstr "API-sleutels van provider"

msgid "openai_api_key"
msgstr "OpenAI API-sleutel"

msgid "openai_api_key_help"
msgstr "De API-sleutel voor de geselecteerde provider. Laat leeg om de bestaande sleutel te behouden."

msgid "openrouter_api_key"
msgstr "OpenRouter API-sleutel"

msgid "openrouter_api_key_help"
msgstr "De API-sleutel voor de geselecteerde provider. Laat leeg om de bestaande sleutel te behouden."

msgid "ollama_api_key"
msgstr "Ollama Cloud API-sleutel"

msgid "ollama_api_key_help"
msgstr "De API-sleutel voor de geselecteerde provider. Laat leeg om de bestaande sleutel te behouden."

msgid "custom_api_key"
msgstr "Aangepaste API-sleutel"

msgid "custom_api_key_help"
msgstr "De API-sleutel voor de geselecteerde provider. Laat leeg om de bestaande sleutel te behouden."

msgid "EXEC_DIVIDER_PROMPT"
msgstr "Generieke geprivilegieerde opdracht (Geavanceerd)"

msgid "priv_tools_available"
msgstr "Whitelist voor wrapper-scripts"

msgid "priv_tools_available_help"
msgstr "Alleen goedgekeurde wrapper-scripts. De assistent mag opdrachten uit deze lijst uitvoeren wanneer generieke geprivilegieerde opdrachten zijn ingeschakeld."

msgid "tools_enabled"
msgstr "AI-tools ingeschakeld"

msgid "tools_enabled_help"
msgstr "De assistent toestaan de geconfigureerde AI-tools te gebruiken."

msgid "allow_generic_privileged_command"
msgstr "Generieke geprivilegieerde opdrachten inschakelen"

msgid "allow_generic_privileged_command_help"
msgstr "Geavanceerde optie. De assistent toestaan de generieke geprivilegieerde opdrachttool te gebruiken met de onderstaande wrapper-whitelist."

msgid "no_key_stored"
msgstr "Geen sleutel opgeslagen"

msgid "key_stored"
msgstr "Opgeslagen: ****"

msgid "exit_fullscreen"
msgstr "Volledig scherm sluiten"

msgid "read_only_tools_enabled"
msgstr "Alleen-lezen tools ingeschakeld"

msgid "read_only_tools_enabled_help"
msgstr "De assistent toestaan veilige alleen-lezen tools te gebruiken voor logs, bestanden, directorylijsten, zoeken en hash-controles."

msgid "diagnostics_tools_enabled"
msgstr "Diagnostische tools ingeschakeld"

msgid "diagnostics_tools_enabled_help"
msgstr "De assistent toestaan systeeminformatie-tools zoals uname, servicestatus en journal-opdrachten te gebruiken."

msgid "actions_tools_enabled"
msgstr "Actietools ingeschakeld"

msgid "actions_tools_enabled_help"
msgstr "De assistent toestaan bevestigingsgebonden actietools te gebruiken zoals serviceherstarts en het schrijven van bestanden."

msgid "no_models_available"
msgstr "Geen modellen beschikbaar"

msgid "local_provider_status"
msgstr "Local inference status"

msgid "local_provider_status_ok"
msgstr "Local inference is available. CPU backend:"

msgid "local_provider_unavailable"
msgstr "Local inference cannot be enabled:"

msgid "local_provider_unavailable_short"
msgstr "Unavailable"

msgid "local_provider_unknown_error"
msgstr "The capability check did not report a reason."

msgid "no_provider_specified"
msgstr "Geen provider opgegeven"
