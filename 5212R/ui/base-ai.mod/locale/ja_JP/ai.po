# Menu items
msgid "ai"
msgstr "AIアシスタント"

msgid "aiDescription"
msgstr "ログ分析とシステム管理のためのAI搭載サーバーアシスタント。"

# Chat
msgid "chat_title"
msgstr "AIアシスタント"

msgid "chat_welcome"
msgstr "AIアシスタントへようこそ。ログの分析、システム状態の確認、サーバー管理をお手伝いできます。何を知りたいですか？"

msgid "chat_placeholder"
msgstr "ここに質問を入力してください..."

msgid "chat_send"
msgstr "送信"

msgid "chat_typing"
msgstr "AIが考えています..."

msgid "chat_no_response"
msgstr "AIサービスから応答がありませんでした。AI設定を確認してください。"

msgid "chat_connection_error"
msgstr "AIサービスに接続できませんでした。サービスが起動しており、正しく設定されているか確認してください。"

# Settings
msgid "settings_title"
msgstr "AI設定"

msgid "settings_save"
msgstr "設定を保存"

msgid "save_success"
msgstr "AI設定が正常に保存されました。"

msgid "save_error"
msgstr "AI設定の保存に失敗しました。もう一度お試しください。"

msgid "DIVIDER_PROVIDER"
msgstr "AIプロバイダ設定"

msgid "enabled"
msgstr "AIアシスタントを有効にする"

msgid "enabled_help"
msgstr "AIアシスタントサービスを有効または無効にします。無効にすると、チャットとAPIエンドポイントはサービス利用不可エラーを返します。"

msgid "provider"
msgstr "AIプロバイダ"

msgid "provider_help"
msgstr "使用するAIプロバイダを選択します。OpenAI、OpenRouter、またはOpenAI互換のカスタムエンドポイントを指定できます。"

msgid "model"
msgstr "モデル名"

msgid "model_help"
msgstr "使用するモデル識別子を指定します（例: gpt-4、claude-3-opus、またはプロバイダでサポートされるカスタム名）。"

msgid "custom_endpoint"
msgstr "APIエンドポイント"

msgid "custom_endpoint_help"
msgstr "APIエンドポイントURL。OpenAI: https://api.openai.com/v1。OpenRouter: https://openrouter.ai/api/v1。カスタムプロバイダの場合はエンドポイントを入力してください。"

msgid "idle_timeout"
msgstr "アイドルタイムアウト（分）"

msgid "idle_timeout_help"
msgstr "最後の要求後に、リソース節約のため停止するまでAIバックエンドサービスが稼働する時間。"

msgid "DIVIDER_PROMPT"
msgstr "システムプロンプト"

msgid "system_prompt"
msgstr "システムプロンプト"

msgid "system_prompt_help"
msgstr "AIアシスタントの動作、利用可能なツール、制約を定義するシステムプロンプトです。すべての要求とともにAIプロバイダへ送信されます。"

# Error messages
msgid "must_enable_service"
msgstr "AIアシスタントサービスは現在無効です。チャットを使用するにはAI設定で有効にしてください。"

msgid "service_unavailable"
msgstr "AIサービスは現在利用できません。サービスが有効で正しく設定されているか、AI設定ページで確認してください。"

msgid "invalid_session"
msgstr "無効または期限切れのAIセッションです。新しい会話を開始してください。"

msgid "provider_error"
msgstr "AIプロバイダがエラーを返しました。APIキーとモデル設定を確認してください。"

msgid "rate_limited"
msgstr "リクエストが多すぎます。しばらく待ってからもう一度メッセージを送信してください。"

msgid "function_not_found"
msgstr "要求されたAI関数は存在しません。"

msgid "chat_html"
msgstr ""

msgid "chat_html_help"
msgstr ""

msgid "provider_openai"
msgstr "OpenAI"

msgid "provider_openrouter"
msgstr "Openrouter"

msgid "provider_ollama"
msgstr "Ollama Cloud"

msgid "provider_anthropic"
msgstr "Anthropic"

msgid "provider_custom"
msgstr "Custom Provider"

msgid "provider_local"
msgstr "Local Provider"

####

msgid "DIVIDER_API_KEYS"
msgstr "プロバイダのAPIキー"

msgid "openai_api_key"
msgstr "OpenAI APIキー"

msgid "openai_api_key_help"
msgstr "選択したプロバイダのAPIキーです。既存のキーを保持するには空欄のままにしてください。"

msgid "openrouter_api_key"
msgstr "OpenRouter APIキー"

msgid "openrouter_api_key_help"
msgstr "選択したプロバイダのAPIキーです。既存のキーを保持するには空欄のままにしてください。"

msgid "ollama_api_key"
msgstr "Ollama Cloud APIキー"

msgid "ollama_api_key_help"
msgstr "選択したプロバイダのAPIキーです。既存のキーを保持するには空欄のままにしてください。"

msgid "custom_api_key"
msgstr "カスタムAPIキー"

msgid "custom_api_key_help"
msgstr "選択したプロバイダのAPIキーです。既存のキーを保持するには空欄のままにしてください。"

msgid "EXEC_DIVIDER_PROMPT"
msgstr "汎用特権コマンド（詳細設定）"

msgid "priv_tools_available"
msgstr "ラッパースクリプトのホワイトリスト"

msgid "priv_tools_available_help"
msgstr "承認済みのラッパースクリプトのみ。一般特権コマンドが有効な場合、アシスタントはこの一覧のコマンドを実行できます。"

msgid "tools_enabled"
msgstr "AIツールを有効にする"

msgid "tools_enabled_help"
msgstr "アシスタントが設定済みのAIツールを使用できるようにします。"

msgid "allow_generic_privileged_command"
msgstr "汎用特権コマンドを有効にする"

msgid "allow_generic_privileged_command_help"
msgstr "詳細設定。下のラッパーのホワイトリストを使って、アシスタントが汎用特権コマンドツールを使用できるようにします。"

msgid "no_key_stored"
msgstr "キーは保存されていません"

msgid "key_stored"
msgstr "保存済み: ****"

msgid "exit_fullscreen"
msgstr "全画面を終了"

msgid "read_only_tools_enabled"
msgstr "読み取り専用ツールを有効にする"

msgid "read_only_tools_enabled_help"
msgstr "アシスタントがログ、ファイル、ディレクトリ一覧、検索、ハッシュ確認のための安全な読み取り専用ツールを使用できるようにします。"

msgid "diagnostics_tools_enabled"
msgstr "診断ツールを有効にする"

msgid "diagnostics_tools_enabled_help"
msgstr "アシスタントがuname、サービス状態、journalクエリなどのシステム情報ツールを使用できるようにします。"

msgid "actions_tools_enabled"
msgstr "操作ツールを有効にする"

msgid "actions_tools_enabled_help"
msgstr "アシスタントがサービス再起動やファイル書き込みなど、確認が必要な操作ツールを使用できるようにします。"

msgid "no_models_available"
msgstr "利用可能なモデルがありません"

msgid "local_provider_status"
msgstr "Local inference status"

msgid "local_provider_status_ok"
msgstr "Local inference is available. CPU backend:"

msgid "local_provider_unavailable"
msgstr "Local inference cannot be enabled:"

msgid "local_provider_unavailable_short"
msgstr "Unavailable"

msgid "local_provider_unknown_error"
msgstr "The capability check did not report a reason."

msgid "no_provider_specified"
msgstr "プロバイダが指定されていません"
