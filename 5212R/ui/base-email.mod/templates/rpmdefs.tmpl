# configuration bits for mod_rpmize
# syntax:
# <begin [x]section>
# <end [x]section>
#
# x an be $ for a string or % for a hash.
# if a hash is being used, you can add sub-sections with
# <begin sub-section>
# <end sub-section>


<begin $DESCRIPTION>
%package [LABEL]
Group: System Environment/BlueOnyx
Summary: [LABEL] for [VENDOR]-[SERVICE].
[AUTOFILL]
[BUILDARCH]

%description [LABEL]
The [VENDOR]-[SERVICE]-[LABEL] package contains the [LABEL]
information for [VENDOR]-[SERVICE].

<end $DESCRIPTION>

<begin %PREP>
<end %PREP>

<begin %SETUP>
<end %SETUP>

<begin %BUILD>
<end %BUILD>

<begin %INSTALL>
<end %INSTALL>

<begin %FILES>
<begin HEADER>
%files [LABEL]
%defattr(-,root,root)
<end HEADER>

<begin locale>
[AUTOFILL]

<end locale>

<begin glue>
%attr(0755,root,root)/usr/local/sbin/vacation.pl
%attr(0755,root,root)/usr/local/sbin/break-smrsh-loop.pl
%attr(0644,root,root)/etc/cron.d/break-smrsh-loop.cron
%attr(0644,root,root)/etc/dovecot/conf.d/10-ssl.conf.bx
%attr(0755,root,root)/etc/cron.daily/mboxfix.pl
%attr(0755,root,root)/usr/sausalito/bin/remove_domain.pl
%attr(0755,root,root)/usr/sausalito/bin/findalias.pl
%attr(0755,root,root)/usr/sausalito/bin/blueonyx-postfix-confgen
%attr(0755,root,root)/usr/sausalito/bin/blueonyx-postfix-canonical.pl
%attr(0755,root,root)/usr/sausalito/bin/blueonyx-postfix-generate-sender-login-maps.pl
%attr(0755,root,root)/usr/sausalito/bin/whichmta
%attr(0755,root,root)/usr/sausalito/bin/get_opendkim.pl
%attr(0755,root,root)/usr/sausalito/sbin/email-auth-helper.pl
%attr(0755,root,root)/usr/sausalito/bin/blueonyx-auth-maponly
%attr(0644,root,root)/etc/dovecot/conf.d/blueonyx-auth.conf.ext
%config(noreplace)/usr/sausalito/bin/custom-postfix-confgen.sh
/etc/smrsh/vacation.pl
%config(noreplace)/etc/httpd/conf.d/radicale_redirects.conf
[AUTOFILL]

<end glue>

<begin ui>
[AUTOFILL]

<end ui>

<begin capstone>
%{RootDir}/capstone/%{Vendor}-%{Service}.cap
[AUTOFILL]

<end capstone>
<end %FILES>

<begin %POST-INSTALL>
<begin HEADER>
%post [LABEL]
<end HEADER>

<begin capstone>
# capstone post-install

<end capstone>

<begin glue>
# glue post-install
if [ ! -d /etc/mail ]; then \
	mkdir -p /etc/mail; \
fi

if [ $1 -gt 1 ]; then
    /usr/sausalito/bin/remove_domain.pl &>/dev/null || :
fi

if [ -f /usr/sausalito/bin/custom-postfix-confgen.sh ];then
    chmod 0755 /usr/sausalito/bin/custom-postfix-confgen.sh
    chown root:root /usr/sausalito/bin/custom-postfix-confgen.sh
fi

# Check if we already have the Dovecot 2.3.8 provisions set:
if [ -f /etc/dovecot/conf.d/10-ssl.conf ]; then
  ISPRESENT=`cat /etc/dovecot/conf.d/10-ssl.conf|grep '^ssl_dh ='|wc -l`
else
  ISPRESENT=0
fi

# If the ciphers are not yet set, copy the new config over:
if (test $ISPRESENT = 0 ); then
  cat /etc/dovecot/conf.d/10-ssl.conf.bx > /etc/dovecot/conf.d/10-ssl.conf
fi

# Create 4096 Bit DH:
if [ -f /var/lib/dovecot/ssl-parameters.dat ] && [ ! -f /etc/dovecot/dh.pem ];then
  dd if=/var/lib/dovecot/ssl-parameters.dat bs=1 skip=88 | openssl dhparam -inform der > /etc/dovecot/dh.pem
fi

# Disable NetworkManager check in /usr/libexec/dovecot/prestartscript:
sed -i 'sX^/bin/systemctlX#/bin/systemctlXg' /usr/libexec/dovecot/prestartscript

# Fix Z-Push:
if [ -f /usr/sausalito/bin/z-push-fixes.sh ];then
	/usr/sausalito/bin/z-push-fixes.sh &>/dev/null || :
fi

if [ -f /var/run/dovecot/login/imap ]; then
  if [ -S /usr/sausalito/cced.socket ]; then
	 systemctl condrestart dovecot &>/dev/null || :
  fi
fi

# Restart CCEd and run Swatch for good measure:
if [ -S /usr/sausalito/cced.socket ]; then
    # Restart CCEd: 
    if [ -d "/usr/sausalito/yumcce" ];then 
      touch /usr/sausalito/yumcce/restart
    fi 
    /usr/sausalito/constructor/base/email/syncEmailOpenDKIM.pl &>/dev/null || :
    /usr/sausalito/constructor/base/email/syncEmailService.pl &>/dev/null || :
fi

<end glue>
<begin ui>
# ui post-install

<end ui>
<begin locale>
# locale post-install

<end locale>
<end %POST-INSTALL>

<begin %POST-UNINSTALL>
<begin HEADER>
%postun [LABEL]
<end HEADER>

<begin glue>
# glue post-uninstall

<end glue>
<begin ui>
# ui post-uninstall

<end ui>
<begin locale>
# locale post-uninstall

<end locale>
<end %POST-UNINSTALL>

