msgid "duplicateKeys"
msgstr "Les informations concernant le blocage et les relais n'ont pas pu être mis à jour. Il y a des entrées en duplicata d'hôtes ou de domaines. Le courriel d'un hôte ou de domaine ne peut pas être bloqué et relayé simultanément."

msgid "emailServers"
