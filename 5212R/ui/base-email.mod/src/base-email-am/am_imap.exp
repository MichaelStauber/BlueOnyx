#!/usr/bin/expect
# IMAP/IMAPS Active Monitor check for BlueOnyx
# Service-level check only. Dovecot owns IMAP/IMAPS.

source /usr/sausalito/swatch/statecodes.tcl

if {![info exists env(redMsg)] || $env(redMsg) eq ""} {
    set env(redMsg) {[[base-email.amIMAPNotRunning]]}
}
if {![info exists env(greenMsg)] || $env(greenMsg) eq ""} {
    set env(greenMsg) {[[base-email.amIMAPStatusOK]]}
}

log_user 0
set timeout 5

proc service_is_active {} {
    set rc [catch {exec /bin/systemctl is-active --quiet dovecot} result]
    if {$rc == 0} {
        return 1
    }
    return 0
}

if {[service_is_active]} {
    puts -nonewline $env(greenMsg)
    flush stdout
    exit $AM_STATE_GREEN
}

# One retry before attempting restart.
sleep 2

if {[service_is_active]} {
    puts -nonewline $env(greenMsg)
    flush stdout
    exit $AM_STATE_GREEN
}

# Dovecot is really not active. Restart once.
catch {exec /bin/systemctl restart dovecot >&/dev/null} result

# Give systemd a short but sane window.
for {set i 0} {$i < 10} {incr i} {
    sleep 1

    if {[service_is_active]} {
        puts -nonewline $env(greenMsg)
        flush stdout
        exit $AM_STATE_GREEN
    }
}

puts -nonewline $env(redMsg)
flush stdout
exit $AM_STATE_RED
