msgid "userSuspended_help"
msgstr "Este usuario se ha suspendido y se le negará el acceso a los servicios del sistema asociados a esa cuenta, como telnet, FTP, correo electrónico y acceso web a sus archivos. Correo electrónico enviado a esta cuenta será rechazada y el remitente recibirá un mensaje de error."

msgid "rights"
msgstr "Estado"

msgid "rights_help"
