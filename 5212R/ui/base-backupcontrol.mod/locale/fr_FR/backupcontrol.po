### GUI port and URIs:
#

msgid "GUI_PORT"
msgstr "Port HTTPS de l'interface graphique"

msgid "GUI_PORT_help"
msgstr "Spécifiez le port HTTPS pour accéder à l'interface graphique. Le port par défaut est 81."

msgid "GUI_URLs"
msgstr "Alias de l'interface graphique"

msgid "GUI_URLs_help"
msgstr "Spécifiez les alias Apache qui redirigent vers la page de connexion de l'interface graphique. Ce champ ne peut pas être vide."

msgid "GUI_PORT_in_use"
msgstr "Le port de l'interface graphique spécifié est déjà utilisé par un autre service. Veuillez sélectionner un autre port."

msgid "GUI_URLs_minimum_fail"
msgstr "Vous devez spécifier au moins un alias Apache qui redirige vers l'interface de l'interface graphique."
