# configuration bits for mod_rpmize
# syntax:
# <begin [x]section>
# <end [x]section>
#
# x an be $ for a string or % for a hash.
# if a hash is being used, you can add sub-sections with
# <begin sub-section>
# <end sub-section>


<begin $DESCRIPTION>
%package [LABEL]
Group: System Environment/BlueOnyx
Summary: [LABEL] for [VENDOR]-[SERVICE].
[AUTOFILL]
[BUILDARCH]

%description [LABEL]
The [VENDOR]-[SERVICE]-[LABEL] package contains the [LABEL]
information for [VENDOR]-[SERVICE].

<end $DESCRIPTION>

<begin %PREP>
<end %PREP>

<begin %SETUP>
<end %SETUP>

<begin %BUILD>
<end %BUILD>

<begin %INSTALL>
<end %INSTALL>

<begin %FILES>
<begin HEADER>
%files [LABEL]
%defattr(-,root,root)
<end HEADER>

<begin locale>
[AUTOFILL]

<end locale>

<begin glue>
[AUTOFILL]

<end glue>

<begin ui>
[AUTOFILL]
%{RootDir}/ui/web/robots.txt
%{RootDir}/ui/web/libImage/*
%{RootDir}/ui/web/.elm/*
%{RootDir}/ui/web/.xterm/*
%{RootDir}/ui/web/.wftp/*
%{RootDir}/ui/web/.elm/.bowerrc
%{RootDir}/ui/web/.elm/.jshintrc
%{RootDir}/ui/web/.htaccess
%{RootDir}/ui/web/index.php
%{RootDir}/ui/web/fqdn.php
%{RootDir}/ui/web/favicon.ico
%{RootDir}/ui/chorizo/ci4/*
/usr/share/doc/blueonyx-release-520XR/CHORIZO-readme.txt
%{RootDir}/ui/chorizo/ci4/CHORIZO-readme.txt
%attr(0700,admserv,admserv) %{RootDir}/license
%attr(0700,admserv,admserv) %{RootDir}/capcache
#%attr(0700,admserv,admserv) %{RootDir}/sessions
%attr(0755,admserv,admserv) %{RootDir}/ui/chorizo/ci4/writable
%attr(0644,root,root) %{RootDir}/ui/chorizo/ci4/.env
%attr(0644,root,root) %{RootDir}/ui/chorizo/ci4/.env.bx
%attr(0644,root,root) %{RootDir}/ui/chorizo/ci4/.gitignore
%attr(0755,root,root) %{RootDir}/ui/chorizo/ci4/bx_ci4_fixer.sh
%attr(0755,root,root) %{RootDir}/ui/chorizo/ci4/spark
%attr(0755,root,root) %{RootDir}/bin/bx-zap-gui-cache.php

<end ui>

<begin capstone>
%{RootDir}/capstone/%{Vendor}-%{Service}.cap
/etc/sysconfig/firstboot
%attr(0755,root,root)/etc/cron.hourly/bxalpine.cron
[AUTOFILL]

<end capstone>
<end %FILES>

<begin %POST-INSTALL>
<begin HEADER>
%post [LABEL]
<end HEADER>

<begin capstone>
# capstone post-install
<end capstone>

<begin glue>
# glue post-install 
<end glue>
<begin ui>
# ui post-install

# Set Hostname:
BXHN=`/usr/bin/uname -n`
if [ "$BXHN" != '' ];then
  /bin/sed -i -e "s/5211R/$BXHN/" /usr/sausalito/ui/chorizo/ci4/.env
else
  echo "Auto-Insertion of server-name for CodeIgniter produced and empty string. Skipping server-name replacement in .env."
fi

# Set random number for $config['encryption_key'] in the CodeIgniter config:
RANDNUM=`date | sha256sum | base64 | head -c 32; echo`;
if [ "$RANDNUM" != '' ];then
  /bin/sed -i -e "s/b95397a593fed523c20caa10ca12018d/$RANDNUM/" /usr/sausalito/ui/chorizo/ci4/.env
else
  echo "Auto-Generation of encryption key for CodeIgniter produced and empty key. Skipping key replacement in .env."
fi

# Yeah, this shouldn't be here. Nothing to see. Move along. Thanks.
if [ -f /usr/sausalito/constructor/virtbiz/branding/initial_site.pl ]; then
  /usr/sausalito/constructor/virtbiz/branding/initial_site.pl
fi

if [ ! -d /usr/sausalito/license ];then 
  /bin/mkdir /usr/sausalito/license 
  /bin/chmod 700 /usr/sausalito/license/ 
  /bin/chown admserv:admserv /usr/sausalito/license
fi

if [ ! -d /usr/sausalito/capcache ];then 
    /bin/mkdir /usr/sausalito/capcache 
    /bin/chmod 700 /usr/sausalito/capcache/ 
    /bin/chown admserv:admserv /usr/sausalito/capcache
fi

if [ ! -d /usr/sausalito/sessions ];then 
    /bin/mkdir /usr/sausalito/sessions 
fi

if [ -d /usr/sausalito/sessions ];then
    /bin/chmod 700 /usr/sausalito/sessions/ 
    /bin/chown admserv:admserv /usr/sausalito/sessions
fi

if [ -d /usr/sausalito/ui/chorizo/ci4/writable ];then
  /bin/chown -R admserv:admserv /usr/sausalito/ui/chorizo/ci4/writable
fi


# This is a horrible script that old versions of the blueonyx-cd-installer might have
# brought aboard. We need to remove it:
if [ -f /usr/sausalito/constructor/base/blueonyx/51_set_default_services.pl ];then
  /bin/rm -f /usr/sausalito/constructor/base/blueonyx/51_set_default_services.pl
fi

if [ ! -f /var/log/gui-debug.log ];then
  touch /var/log/gui-debug.log
  chown admserv:admserv /var/log/gui-debug.log
fi

# Restart CCEd once YUM is done:
if [ -d /usr/sausalito/yumcce ];then 
  touch /usr/sausalito/yumcce/restart
fi

<end ui>
<begin locale>
# locale post-install

<end locale>
<end %POST-INSTALL>

<begin %POST-UNINSTALL>
<begin HEADER>
%postun [LABEL]
<end HEADER>

<begin glue>
# glue post-uninstall

<end glue>
<begin ui>
# ui post-uninstall

<end ui>
<begin locale>
# locale post-uninstall

<end locale>
<end %POST-UNINSTALL>

