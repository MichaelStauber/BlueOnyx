msgid "DIVIDER_API_KEYS"
msgstr "Udbyderens API-nøgler"

msgid "openai_api_key"
msgstr "OpenAI API-nøgle"

msgid "openai_api_key_help"
msgstr "API-nøglen til den valgte udbyder. Lad feltet være tomt for at beholde den eksisterende nøgle."

msgid "openrouter_api_key"
msgstr "OpenRouter API-nøgle"

msgid "openrouter_api_key_help"
msgstr "API-nøglen til den valgte udbyder. Lad feltet være tomt for at beholde den eksisterende nøgle."

msgid "ollama_api_key"
msgstr "Ollama Cloud API-nøgle"

msgid "ollama_api_key_help"
msgstr "API-nøglen til den valgte udbyder. Lad feltet være tomt for at beholde den eksisterende nøgle."

msgid "anthropic_api_key"
msgstr "Anthropic API-nøgle"

msgid "anthropic_api_key_help"
msgstr "API-nøglen til den valgte udbyder. Lad feltet være tomt for at beholde den eksisterende nøgle."

msgid "custom_api_key"
msgstr "Brugerdefineret API-nøgle"

msgid "custom_api_key_help"
msgstr "API-nøglen til den valgte udbyder. Lad feltet være tomt for at beholde den eksisterende nøgle."

msgid "EXEC_DIVIDER_PROMPT"
msgstr "Generisk privilegeret kommando (Avanceret)"

msgid "priv_tools_available"
msgstr "Whitelist for wrapper-scripts"

msgid "priv_tools_available_help"
msgstr "Kun godkendte wrapper-scripts. Assistenten må køre kommandoer fra denne liste, når generiske privilegerede kommandoer er aktiveret."

msgid "tools_enabled"
msgstr "AI-værktøjer aktiveret"

msgid "tools_enabled_help"
msgstr "Tillad assistenten at bruge de konfigurerede AI-værktøjer."

msgid "allow_generic_privileged_command"
msgstr "Aktiver generiske privilegerede kommandoer"

msgid "allow_generic_privileged_command_help"
msgstr "Avanceret indstilling. Tillad assistenten at bruge det generiske privilegerede kommandoværktøj med wrapper-whitelist nedenfor."

msgid "no_key_stored"
msgstr "Ingen nøgle gemt"

msgid "key_stored"
msgstr "Gemt: ****"

msgid "exit_fullscreen"
msgstr "Forlad fuldskærm"

msgid "read_only_tools_enabled"
msgstr "Skrivebeskyttede værktøjer aktiveret"

msgid "read_only_tools_enabled_help"
msgstr "Tillad assistenten at bruge sikre skrivebeskyttede værktøjer til logs, filer, kataloglister, søgning og hash-kontrol."

msgid "diagnostics_tools_enabled"
msgstr "Diagnoseværktøjer aktiveret"

msgid "diagnostics_tools_enabled_help"
msgstr "Tillad assistenten at bruge systeminformationsværktøjer som uname, tjenestestatus og journalforespørgsler."

msgid "actions_tools_enabled"
msgstr "Handlingsværktøjer aktiveret"

msgid "actions_tools_enabled_help"
msgstr "Tillad assistenten at bruge handlingværktøjer med bekræftelse, såsom genstart af tjenester og skrivning af filer."

msgid "no_models_available"
msgstr "Ingen modeller tilgængelige"

msgid "local_provider_status"
msgstr "Local inference status"

msgid "local_provider_status_ok"
msgstr "Local inference is available. CPU backend:"

msgid "local_provider_unavailable"
msgstr "Local inference cannot be enabled:"

msgid "local_provider_unavailable_short"
msgstr "Unavailable"

msgid "local_provider_unknown_error"
msgstr "The capability check did not report a reason."

msgid "no_provider_specified"
msgstr "Ingen udbyder angivet"
