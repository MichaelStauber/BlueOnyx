# strings for shell menu items

msgid "shellMenu"
msgstr "Accès Serveur"

msgid "shellMenuDescription"
msgstr "Configurer l'accès au serveur pour l'interface graphique, l'accès shell (SSH et Telnet) ainsi que les services liés aux fichiers tels que FTP, SFTP et SCP."

# server wide shell access page

msgid "shell"
msgstr "[[base-shell.shellMenu]]"

# ui extensions

msgid "shellName"
msgstr "Accès Shell"

msgid "enableShell"
msgstr "Activer l'interface système Shell"

msgid "enableShell_help"
msgstr "Activez l'accès shell pour permettre aux utilisateurs suffisamment privilégiés d'utiliser des services tels que Telnet, SSH, SFTP ou SCP."

msgid "userEnableShell"
msgstr "[[base-shell.enableShell]]"

msgid "userEnableShell_help"
msgstr "Activez l'accès shell pour permettre à l'utilisateur de se connecter au serveur en utilisant des services tels que Telnet, SSH, SFTP ou SCP."

msgid "shellIsEnabled"
msgstr "Accès Shell"

msgid "shellIsEnabled_help"
msgstr "L'accès à l'interface système Shell est activé pour cet utilisateur."

# handler error messages
# user_shell.pl
msgid "cantEnableNoVsiteShell"
msgstr "L'accès à l'interface système Shell ne peut pas être activé pour cet utilisateur parce que le site virtuel dont il est membre n'a pas l'accès Shell activé."

# site shell menus

msgid "siteshell"
msgstr "[[base-shell.shellMenu]]"

msgid "siteshell_help"
msgstr "Configurez l'accès pour l'interface graphique, l'accès shell (SSH et Telnet) ainsi que les services liés aux fichiers tels que FTP, SFTP et SCP pour ce site."

msgid "siteShellSettings"
msgstr "Paramètres de l'interface système Shell pour [[VAR.fqdn]]"

msgid "cap_serverShell"
msgstr "Paramètres Shell"

