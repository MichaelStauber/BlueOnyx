[Unit]
Description=The PHP-9.1 FastCGI Process Manager
After=syslog.target network.target

[Service]
Type=notify
PIDFile=/run/php-fpm/php-fpm-9.1.pid
EnvironmentFile=/etc/sysconfig/php-fpm
ExecStart=/home/solarspeed/php-9.1/sbin/php-fpm --nodaemonize
ExecReload=/bin/kill -USR2 $MAINPID
PrivateTmp=true
Restart=on-failure

[Install]
WantedBy=multi-user.target

