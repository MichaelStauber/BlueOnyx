%define extension_dir %(php-config --extension-dir)
%define adm_php_prefix /home/solarspeed/admserv-php
%define adm_extension_dir %(echo %{adm_php_prefix}/lib/php/20230831)
%define adm_php_ini_dir %{adm_php_prefix}/etc/php.d

Summary: Cobalt CCE Server and Clients
Name: sausalito-cce
Version: XX_VER_XX
Release: XX_REL_XX%{?dist}
Vendor: %{vendor}
License: Sun modified BSD
Group: System Environment/BlueOnyx
Source: sausalito-cce.tar.gz
Prefix: /usr/sausalito
BuildRoot: /var/tmp/cce-root
BuildRequires: glib-devel, pam-devel, glib2-devel
BuildRequires: flex, bison, libfl-static
BuildRequires: php-devel, cmake
BuildRequires: CUnit-devel
BuildRequires: chrpath
BuildRequires: openssl-devel
%if 0%{?rhel} >= 10
BuildRequires: valkey-devel
%else
BuildRequires: hiredis-devel
%endif

# Maximum RPM: "There are times when RPM's automatic dependency
# processing may not be desirable."  Yeah, like when it crashes.
# AutoReqProv: no

%description
sausalito-cce has both the server and client parts of cce.

%package server
Group: System Environment/BlueOnyx
Summary: The CCE server daemon
Requires: glib, glib-ghash, pam, policycoreutils
%if "%centos" == "5" 
Requires: audit-libs
%endif 


%description server
The cce-server package contains the server-side parts of the Cobalt 
Configuration Engine.

%package client
Group: System Environment/BlueOnyx
Summary: The CCE client libraries
Requires: glib, glib-ghash, pam, httpd, base-admserv-glue perl-Time-Out

%description client
The cce-client package contains the client-side parts of the Cobalt 
Configuration Engine.

%prep
%setup -n cce

%build
make all \
	CCETOPDIR=/usr/sausalito

# Build cce.so PHP extension via phpize
cd client/php/src
CCE_TOPDIR=%{_builddir}/cce ADM_PHP_PREFIX=%{adm_php_prefix} make
cd -

%install
rm -rf $RPM_BUILD_ROOT
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/sbin
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/bin
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/codb
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/codb/txn
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/conf
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/schemas
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/sessions
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/handlers
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/constructor
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/destructor
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/capstone
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/devel
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/lib
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/include
mkdir -p $RPM_BUILD_ROOT/usr/sausalito/perl
#mkdir -p $RPM_BUILD_ROOT/etc/rc.d/init.d
mkdir -p $RPM_BUILD_ROOT/usr/lib/systemd/system
mkdir -p $RPM_BUILD_ROOT/etc/pam.d
mkdir -p $RPM_BUILD_ROOT/etc/security
mkdir -p $RPM_BUILD_ROOT/var/lib/pam_abl
mkdir -p $RPM_BUILD_ROOT/lib/security
mkdir -p $RPM_BUILD_ROOT/etc/php.d
make install PREFIX=$RPM_BUILD_ROOT CCETOPDIR=/usr/sausalito

# Install cce.so and cce.ini for AdmServ PHP
install -d $RPM_BUILD_ROOT%{adm_extension_dir}
install -d $RPM_BUILD_ROOT%{adm_php_ini_dir}
install -m 0755 client/php/src/build/modules/cce.so $RPM_BUILD_ROOT%{adm_extension_dir}/cce.so
install -m 0644 client/php/src/cce.ini $RPM_BUILD_ROOT%{adm_php_ini_dir}/cce.ini

# Install pam_abl binaries, library and config:
make -C pam_abl install DESTDIR=$RPM_BUILD_ROOT

# Remove duplicates:
rm -f $RPM_BUILD_ROOT/bin/pam_abl
rm -f $RPM_BUILD_ROOT/bin/pam_abl_test
rm -f $RPM_BUILD_ROOT/sausalito/bin/pam_abl_gui
rm -f $RPM_BUILD_ROOT/share/man/man1/pam_abl.1.gz
rm -f $RPM_BUILD_ROOT/share/man/man5/pam_abl.conf.5.gz
rm -f $RPM_BUILD_ROOT/share/man/man8/pam_abl.8.gz

%files server
%defattr(-,root,root)
%doc LICENSE.txt
%dir /usr/sausalito/
%dir /usr/sausalito/sbin
/usr/sausalito/sbin/*
%dir /usr/sausalito/bin
/usr/sausalito/bin/pperl
/usr/sausalito/bin/pperld
/usr/sausalito/bin/pam_abl_flush.sh
/usr/sausalito/bin/functions
%dir /usr/sausalito/codb
%dir /usr/sausalito/codb/txn
%dir /usr/sausalito/conf
%dir /usr/sausalito/schemas
/usr/sausalito/schemas/*
%dir %attr(0700, admserv,admserv) /usr/sausalito/sessions
%dir /usr/sausalito/handlers
%dir /usr/sausalito/constructor
%dir /usr/sausalito/destructor
%dir /usr/sausalito/capstone
%dir /usr/sausalito/devel
%dir /usr/sausalito/lib
%dir /usr/sausalito/include
%dir /usr/sausalito/perl
%attr(0644,root,root) /usr/lib/systemd/system/*
/etc/pam.d/*
/lib/security/*
# For 64-bit pam_abl if this is a 64-bit system:
%ifarch x86_64 
/lib64/security/*
%endif

/var/lib/pam_abl
/usr/bin/pam_abl
/usr/bin/pam_abl_test
/usr/sausalito/bin/pam_abl_gui
%config(noreplace) /etc/security/pam_abl.conf
/usr/share/man/man1/pam_abl.1.gz
/usr/share/man/man5/pam_abl.conf.5.gz
/usr/share/man/man8/pam_abl.8.gz

%files client
%attr(-,root,XX_USER_HTTPD_XX)/usr/sausalito/bin/ccewrap
/usr/sausalito/bin/cced_unstuck.sh
/usr/sausalito/bin/mysql_statustrigger.pl
/usr/sausalito/bin/check_cce.pl
/etc/sudoers.d/admserv
%config %attr(-,root,root)/etc/ccewrap.conf
%defattr(-,root,root)
%doc LICENSE.txt
%dir /etc/ccewrap.d
/usr/sausalito/bin/cce_construct  
/usr/sausalito/bin/cceclient
/usr/sausalito/lib/*.so*
/usr/sausalito/include/*
/usr/sausalito/ui/libPhp/*
/usr/sausalito/perl/*
%{adm_extension_dir}/cce.so
%config(noreplace) %{adm_php_ini_dir}/cce.ini
/usr/share/locale/*
%config(noreplace) /etc/httpd/conf.d/blueonyx.conf

%post server

# Reload Daemon anyway (if EL7):
if [ -f /usr/bin/systemctl ];then
  /usr/bin/systemctl daemon-reload 2> /dev/null || : 
fi

if [ $1 -eq 1 ]; then
  # Install
  /usr/bin/systemctl enable cced.init.service 2> /dev/null || : 
  /usr/bin/systemctl enable cced.construct.service 2> /dev/null || : 
else
  # Upgrade
  /usr/bin/systemctl enable cced.init.service 2> /dev/null || : 
  /usr/bin/systemctl enable cced.construct.service 2> /dev/null || : 
  /usr/bin/systemctl restart cced.init.service 2> /dev/null || : 
  /usr/bin/systemctl restart cced.construct.service 2> /dev/null || : 
fi

%preun server
# only run if this is the last instance to be removed
if [ $1 -eq 0 ]; then
    /usr/bin/systemctl stop cced.init.service 2> /dev/null || : 
    /usr/bin/systemctl stop cced.construct.service 2> /dev/null || : 
    /usr/bin/systemctl disable cced.init.service 2> /dev/null || : 
    /usr/bin/systemctl disable cced.construct.service 2> /dev/null || : 
    /usr/bin/systemctl daemon-reload 2> /dev/null || : 
fi

%post client
# only run on install, not upgrade
if [ $1 -eq 1 ]; then
  LIB=/usr/sausalito/lib
  cp /etc/ld.so.conf /etc/ld.so.conf.bak
  grep -E "^$LIB[   ]*$" /etc/ld.so.conf >/dev/null \
    || echo $LIB >> /etc/ld.so.conf
  /sbin/ldconfig
fi

# Add user 'admserv':
/usr/sbin/useradd -c "Admserv" -u 49 -s /sbin/nologin -r -d /usr/sausalito/ui admserv 2> /dev/null || : 

# resetup the owner of ccewrap
/bin/chgrp admserv /usr/sausalito/bin/ccewrap
/bin/chmod u+s /usr/sausalito/bin/ccewrap

# The joys of config(noreplace)! We have to fix it this way:
/bin/sed -i -e 's/login\.php/login/' /etc/httpd/conf.d/blueonyx.conf

# Restart AdmServ PHP-FPM to pick up new/updated cce.so extension:
if [ -x /bin/systemctl ]; then
	/bin/systemctl try-restart admserv-php-fpm.service >/dev/null 2>&1 || :
fi

%postun client
# reload httpd
if [ "$1" -ge "1" ]; then
	/usr/bin/systemctl restart httpd 2> /dev/null || :
	/usr/bin/systemctl restart admserv 2> /dev/null || :
fi

%changelog

* Fri Jul 24 2026 Michael Stauber <mstauber@solarspeed.net> 0.99.6-6
- Added 5212R detection to SACPAM PAM config selection in server/Makefile
- Enabled pam_abl in system-auth-cce.pam (all variants: default, 64-bit, 5209R)
- Disabled pam_cracklib in system-auth-cce.pam.5209R (cracklib not available on el10)

* Mon Jun 22 2026 Michael Stauber <mstauber@solarspeed.net> 0.99.6-5
- Modified ccewrap/cced_unstuck.sh to also restart CCEd-API

* Sun May 17 2026 Michael Stauber <mstauber@solarspeed.net> 0.99.6-4
- Modified cscp/src/cscp_parse.c to extend the Logging filter to not only replace
  values with "xxx" in the log if the key contained 'password' (exact match), but
  to also do replacements for 'sql_rootpassword', 'newpass', 'oldpass' (all exact
  matches) or anything with 'pass' or 'api_key' (regexp) in their key-names.

* Sun Apr 26 2026 Michael Stauber <mstauber@solarspeed.net> 0.99.6-3
- Modernized cce.so PHP Zend API module for PHP 8.3.30 compatibility
- Replaced deprecated PHP 5.4 Zend API calls with PHP 8.3 equivalents
- Added arginfo definitions for all 22 exported PHP functions
- Converted build system from raw gcc to phpize/configure (matching i18n module)
- Added config.m4 for phpize-based build
- Added cce.ini for AdmServ PHP extension loading
- Install cce.so to AdmServ PHP extension dir and cce.ini to AdmServ php.d
- Removed disabled cce.so build code; the module now builds and installs again
- Updated php_cce.h with correct function declarations matching cce.c

* Thu Apr 23 2026 Michael Stauber <mstauber@solarspeed.net> 0.99.6-2
- Hardened Redis/Valkey session storage by deriving Redis keys from
  HMAC-SHA256(session_id) using a root-only local secret.
- cced systemd unit now creates /usr/sausalito/conf/sessionmgr.secret if
  missing or empty and enforces 0600 root:root permissions without rotating
  the secret on restarts.
- Redis/Valkey no longer exposes raw CCE session IDs through key names.
- Added OpenSSL/libcrypto linkage and BuildRequires: openssl-devel.
- Session manager removes legacy raw Redis session keys as sessions are saved
  or expired.

* Tue Apr 21 2026 Michael Stauber <mstauber@solarspeed.net> 0.99.6-1
- Modified sessionmgr to optionally use Redis/Valkey for session storage.
  Falls back to file-based sessions if Redis/Valkey is unavailable.
- BuildRequires: valkey-devel (EL10+) or hiredis-devel (EL8/EL9).
- Session manager now tries 127.0.0.1:6379, then /var/run/valkey/valkey.sock,
  then /var/run/redis/redis.sock, then file-based fallback.
- This restores the memcache feature from 2015 (R:2015) in a safer way.
- Modified rules.mk to always build with Redis/Valkey support

* Tue Apr 21 2026 Michael Stauber <mstauber@solarspeed.net> 0.99.5-7
- Session Manager: Added optional Redis/Valkey support with automatic
  file-based fallback. Tries TCP 127.0.0.1:6379 first, then Unix sockets
  (/var/run/valkey/valkey.sock, /var/run/redis/redis.sock), then falls
  back to file-based sessions.
- Build: Auto-detect hiredis/valkey at build time. BuildRequires updated
  for valkey-devel (EL10+) or hiredis-devel (EL8/EL9).
- CODB: FIND now uses ALL available property indexes and intersects OID
  lists. Dramatically reduces candidate objects for multi-criteria searches.
- CODB: Added new codb_oidset module (codb_oidset.c/h) for efficient OID
  set intersection during FIND queries.
- Fixed 28-year-old TODO in codb_find_oidlist_from_criteria() that only used
  the first index found instead of all matching indexes.

* Sat Apr 18 2026 Michael Stauber <mstauber@solarspeed.net> 0.99.5-6
- Modified server/basetypes.schema to add Typedef 'ipcidr_list_IPv4IPv6'

