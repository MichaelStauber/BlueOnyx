msgid "DIVIDER_API_KEYS"
msgstr "API-Schlüssel des Providers"

msgid "openai_api_key"
msgstr "OpenAI-API-Schlüssel"

msgid "openai_api_key_help"
msgstr "Der API-Schlüssel für den ausgewählten Provider. Leer lassen, um den vorhandenen Schlüssel beizubehalten."

msgid "openrouter_api_key"
msgstr "OpenRouter-API-Schlüssel"

msgid "openrouter_api_key_help"
msgstr "Der API-Schlüssel für den ausgewählten Provider. Leer lassen, um den vorhandenen Schlüssel beizubehalten."

msgid "ollama_api_key"
msgstr "Ollama-Cloud-API-Schlüssel"

msgid "ollama_api_key_help"
msgstr "Der API-Schlüssel für den ausgewählten Provider. Leer lassen, um den vorhandenen Schlüssel beizubehalten."

msgid "anthropic_api_key"
msgstr "Anthropic-API-Schlüssel"

msgid "anthropic_api_key_help"
msgstr "Der API-Schlüssel für den ausgewählten Provider. Leer lassen, um den vorhandenen Schlüssel beizubehalten."

msgid "custom_api_key"
msgstr "Benutzerdefinierter API-Schlüssel"

msgid "custom_api_key_help"
msgstr "Der API-Schlüssel für den ausgewählten Provider. Leer lassen, um den vorhandenen Schlüssel beizubehalten."

msgid "EXEC_DIVIDER_PROMPT"
msgstr "Generischer privilegierter Befehl (Erweitert)"

msgid "priv_tools_available"
msgstr "Whitelist für Wrapper-Skripte"

msgid "priv_tools_available_help"
msgstr "Nur freigegebene Wrapper-Skripte. Der Assistent darf Befehle aus dieser Liste ausführen, wenn generische privilegierte Befehle aktiviert sind."

msgid "tools_enabled"
msgstr "KI-Tools aktiviert"

msgid "tools_enabled_help"
msgstr "Dem Assistenten die Verwendung der konfigurierten KI-Tools erlauben."

msgid "allow_generic_privileged_command"
msgstr "Generische privilegierte Befehle aktivieren"

msgid "allow_generic_privileged_command_help"
msgstr "Erweiterte Option. Dem Assistenten erlauben, das generische privilegierte Befehls-Tool mit der untenstehenden Wrapper-Whitelist zu verwenden."

msgid "no_key_stored"
msgstr "Kein Schlüssel gespeichert"

msgid "key_stored"
msgstr "Gespeichert: ****"

msgid "exit_fullscreen"
msgstr "Vollbild beenden"

msgid "read_only_tools_enabled"
msgstr "Nur-Lese-Tools aktiviert"

msgid "read_only_tools_enabled_help"
msgstr "Dem Assistenten die Verwendung sicherer Nur-Lese-Tools für Logs, Dateien, Verzeichnislisten, Suche und Prüfsummen erlauben."

msgid "diagnostics_tools_enabled"
msgstr "Diagnose-Tools aktiviert"

msgid "diagnostics_tools_enabled_help"
msgstr "Dem Assistenten die Verwendung von Systeminformations-Tools wie uname, Dienststatus und Journal-Abfragen erlauben."

msgid "actions_tools_enabled"
msgstr "Aktions-Tools aktiviert"

msgid "actions_tools_enabled_help"
msgstr "Dem Assistenten die Verwendung bestätigungspflichtiger Aktions-Tools wie Dienstneustarts und Dateischreibvorgänge erlauben."

msgid "no_models_available"
msgstr "Keine Modelle verfügbar"

msgid "local_provider_status"
msgstr "Local inference status"

msgid "local_provider_status_ok"
msgstr "Local inference is available. CPU backend:"

msgid "local_provider_unavailable"
msgstr "Local inference cannot be enabled:"

msgid "local_provider_unavailable_short"
msgstr "Unavailable"

msgid "local_provider_unknown_error"
msgstr "The capability check did not report a reason."

msgid "no_provider_specified"
msgstr "Kein Provider angegeben"
