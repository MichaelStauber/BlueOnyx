msgid "ErrorFileNotPresent"
msgstr "Error: The specified CalDAV/CardDAV collection does not exist."

msgid "ErrorDeletingCollection"
msgstr "An error occured while attempting to delete this CalDAV/CardDAV collection."

msgid "ErrorRestoringBackup"
msgstr "An error occured while attempting to restore the backup for this CalDAV/CardDAV collection(s)."

msgid "ErrorCreatingBackup"
msgstr "An error occured while attempting to create the backup for this CalDAV/CardDAV collection(s)."

