# Menu items
msgid "ai"
msgstr "AI-assistent"

msgid "aiDescription"
msgstr "Op AI gebaseerde serverassistent voor loganalyse en systeembeheer."

# Chat
msgid "chat_title"
msgstr "AI-assistent"

msgid "chat_welcome"
msgstr "Welkom bij de AI-assistent. Ik kan helpen met loganalyse, systeemstatus en serverbeheer. Wat wilt u weten?"

msgid "chat_placeholder"
msgstr "Typ hier uw vraag..."

msgid "chat_send"
msgstr "Verstuur"

msgid "chat_typing"
msgstr "AI denkt na..."

msgid "chat_no_response"
msgstr "Geen antwoord ontvangen van de AI-service. Controleer de AI-instellingen."

msgid "chat_connection_error"
msgstr "Kan geen verbinding maken met de AI-service. Controleer of de service draait en correct is geconfigureerd."

# Settings
msgid "settings_title"
msgstr "AI-instellingen"

msgid "settings_save"
msgstr "Instellingen opslaan"

msgid "save_success"
msgstr "De AI-instellingen zijn succesvol opgeslagen."

msgid "save_error"
msgstr "Opslaan van AI-instellingen mislukt. Probeer het opnieuw."

msgid "DIVIDER_PROVIDER"
msgstr "AI-providerconfiguratie"

msgid "enabled"
msgstr "AI-assistent inschakelen"

msgid "enabled_help"
msgstr "De AI-assistentservice in- of uitschakelen. Wanneer uitgeschakeld geven chat- en API-eindpunten een foutmelding dat de service niet beschikbaar is."

msgid "provider"
msgstr "AI-provider"

msgid "provider_help"
msgstr "Selecteer de AI-provider die u wilt gebruiken. OpenAI, OpenRouter of een aangepaste OpenAI-compatibele endpoint."

msgid "model"
msgstr "Modelnaam"

msgid "model_help"
msgstr "De modelidentifier om te gebruiken (bijv. gpt-4, claude-3-opus of een door uw provider ondersteunde aangepaste modelnaam)."

msgid "custom_endpoint"
msgstr "API-eindpunt"

msgid "custom_endpoint_help"
msgstr "De URL van het API-eindpunt. Voor OpenAI: https://api.openai.com/v1. Voor OpenRouter: https://openrouter.ai/api/v1. Voor aangepaste providers voert u uw endpoint in."

msgid "idle_timeout"
msgstr "Inactiviteitstime-out (minuten)"

msgid "idle_timeout_help"
msgstr "Hoe lang de AI-backendservice na de laatste aanvraag blijft draaien voordat deze wordt afgesloten om bronnen te besparen."

msgid "DIVIDER_PROMPT"
msgstr "Systeemprompt"

msgid "system_prompt"
msgstr "Systeemprompt"

msgid "system_prompt_help"
msgstr "De systeemprompt die het gedrag van de AI-assistent, beschikbare tools en beperkingen definieert. Deze wordt bij elke aanvraag naar de AI-provider verzonden."

# Error messages
msgid "must_enable_service"
msgstr "De AI-assistentservice is momenteel uitgeschakeld. Schakel deze in bij de AI-instellingen om de chat te gebruiken."

msgid "service_unavailable"
msgstr "De AI-service is momenteel niet beschikbaar. Controleer de AI-instellingen om te zorgen dat de service is ingeschakeld en correct geconfigureerd."

msgid "invalid_session"
msgstr "Ongeldige of verlopen AI-sessie. Start een nieuwe conversatie."

msgid "provider_error"
msgstr "De AI-provider heeft een fout geretourneerd. Controleer uw API-sleutel en modelconfiguratie."

msgid "rate_limited"
msgstr "Te veel verzoeken. Wacht even voordat u nog een bericht verzendt."

msgid "function_not_found"
msgstr "De gevraagde AI-functie bestaat niet."

msgid "chat_html"
msgstr ""

msgid "chat_html_help"
msgstr ""

msgid "provider_openai"
msgstr "OpenAI"

msgid "provider_openrouter"
msgstr "Openrouter"

msgid "provider_ollama"
msgstr "Ollama Cloud"

msgid "provider_anthropic"
msgstr "Anthropic"

msgid "provider_custom"
msgstr "Custom Provider"

msgid "provider_local"
msgstr "Local Provider"

