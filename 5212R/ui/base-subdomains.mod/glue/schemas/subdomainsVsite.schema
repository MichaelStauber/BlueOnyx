<!-- $Id: subdomainsVsite.schema -->

<CLASS name="Vsite" namespace="subdomains" version="1.1" createacl="ruleModifyUser" destroyacl="ruleModifyUser" writeacl="ruleModifyUser" readacl="ruleAll">
  <PROPERTY name="enabled" type="boolean" default="1" writeacl="ruleAll"/>
  <PROPERTY name="sub_ssl" type="boolean" default="0" writeacl="ruleAll"/>
  <PROPERTY name="vsite_enabled" type="boolean" default="0" writeacl="ruleAll"/>
  <PROPERTY name="max_subdomains" type="int" default="5" writeacl="ruleAll"/>
</CLASS>

<CLASS name="VsiteServices" namespace="subdomains" version="1.1" createacl="ruleModifyUser" destroyacl="ruleModifyUser" writeacl="ruleModifyUser" readacl="ruleAll">
  <property name="featureEnabled" type="boolean" default="1"/>
  <property name="i18nName" type="scalar" default="[[base-subdomains.sub_domain]]"/>
  <property name="enabled" type="boolean" default="1" writeacl="ruleCapable(adminUser)"/>
</CLASS>

<CLASS name="Subdomains" version="1.1" 

    createacl="ruleCapable(adminUser) OR ruleCapable(siteAdmin)"
    destroyacl="ruleCapable(adminUser) OR ruleCapable(siteAdmin)"
    writeacl="ruleCapable(adminUser) OR ruleCapable(siteAdmin)"
    readacl="ruleAll" > 

  <PROPERTY name="hostname"   type="alphanum_plus"  default=""    writeacl="ruleCapable(adminUser) OR ruleCapable(siteAdmin)" optional="yes" />
  <PROPERTY name="domainname" type="domainname"     default=""    writeacl="ruleCapable(adminUser) OR ruleCapable(siteAdmin)" />
  <PROPERTY name="webpath"    type="scalar"         default=""    writeacl="ruleCapable(adminUser) OR ruleCapable(siteAdmin)" />
  <PROPERTY name="props"      type="alphanum"       default=""    writeacl="ruleCapable(adminUser) OR ruleCapable(siteAdmin)" />
  <PROPERTY name="group"      type="word"           default=""    writeacl="ruleCapable(adminUser) OR ruleCapable(siteAdmin)" />
  <PROPERTY name="isUser"     type="boolean"        default="0"   writeacl="ruleCapable(adminUser) OR ruleCapable(siteAdmin)" />
  <PROPERTY name="force_update"   type="scalar"  default=""    writeacl="ruleCapable(adminUser) OR ruleCapable(siteAdmin)" optional="yes" />
</CLASS>


