%dir /usr/sausalito/runonce
%dir /usr/sausalito/configs
/usr/sausalito/configs/*
%dir /usr/sausalito/triggers
/usr/sausalito/triggers/*
/etc/build
/var/www/html/*
%dir /usr/share/doc/blueonyx-release-5212R
/usr/share/doc/blueonyx-release-5212R/*
%attr(0644,root,root) /usr/lib/systemd/system/blueonyx.service
%config(noreplace) /usr/share/ssl/certs/sendmail-2048.dh
%config(noreplace) /var/lib/dovecot/ssl-parameters.dat
<end glue>

<begin ui>
[AUTOFILL]

<end ui>

<begin capstone>
%{RootDir}/capstone/%{Vendor}-%{Service}.cap
[AUTOFILL]

<end capstone>
<end %FILES>

<begin %POST-INSTALL>
<begin HEADER>
%post [LABEL]
<end HEADER>

<begin glue>
# glue post-install

touch /tmp/blueonyx-glue-post-install.log

# Handle SELinux:
if [ -f /etc/selinux/config ];then
  /bin/sed -i -e 's@^SELINUX=enforcing@SELINUX=disabled@' /etc/selinux/config
  echo 'Handled SELinux' >> /tmp/blueonyx-glue-post-install.log
fi

# Enable CCEd:
systemctl enable blueonyx.service &>/dev/null || :
systemctl enable cced.init.service &>/dev/null || :
systemctl enable cced.construct.service &>/dev/null || :

# Check if CCEd is up:
if [ $1 -eq 2 ]; then
  # Only run this if this is an upgrade:
  if [ ! -S /usr/sausalito/cced.socket ]; then
    # Not up - restarting:
    /usr/sausalito/sbin/cced.init restart &>/dev/null || :
    echo 'Restarted CCEd' >> /tmp/blueonyx-glue-post-install.log
  fi
fi

if [ $1 -eq 1 ]; then
  # ONLY run this on first install, NOT upgrades!
  # This creates the persistend network rules with ethX style interfaces:
  /usr/sausalito/sbin/write_udev.pl > /etc/udev/rules.d/70-persistent-net.rules
  echo 'Ran /usr/sausalito/sbin/write_udev.pl > /etc/udev/rules.d/70-persistent-net.rules' >> /tmp/blueonyx-glue-post-install.log
fi

if [ $1 -eq 1 ]; then
  if [ ! -d "/usr/sausalito/runonce" ];then
    mkdir -p /usr/sausalito/runonce
    echo 'ran: mkdir -p /usr/sausalito/runonce' >> /tmp/blueonyx-glue-post-install.log
  fi
  cd /usr/sausalito/scripts
  for FILE in *; do
    if [ -f $FILE ]; then
        if [ ! -L "/usr/sausalito/runonce/$FILE" ]; then
            ln -sf /usr/sausalito/scripts/$FILE /usr/sausalito/runonce/$FILE
            echo "ln -sf /usr/sausalito/scripts/$FILE /usr/sausalito/runonce/$FILE" >> /tmp/blueonyx-glue-post-install.log
        fi
    fi
  done
fi

# update product information
if [ -S /usr/sausalito/cced.socket ]; then
  /usr/sausalito/sbin/updateSystem.pl &>/dev/null || :
  echo 'Ran: /usr/sausalito/sbin/updateSystem.pl' >> /tmp/blueonyx-glue-post-install.log
fi

# update sendmail config files
if [ $1 -eq 1 ]; then
  # Pretty please: Only on new installs, not updates!
  /bin/grep 'setup for BlueOnyx' /etc/mail/sendmail.mc > /dev/null 2>&1
  if [ $? = 0 ]; then
    /bin/mv /etc/mail/sendmail.mc /etc/mail/sendmail.mc.bxold
    /bin/mv /etc/mail/sendmail.cf /etc/mail/sendmail.cf.bxold
    /usr/sausalito/scripts/initSendmail.sh &>/dev/null || :
    echo 'Ran: /usr/sausalito/scripts/initSendmail.sh (#1)' >> /tmp/blueonyx-glue-post-install.log
  fi

  # Make sure sendmail.mc has confMAX_RCPTS_PER_MESSAGE:
  /bin/grep 'confMAX_RCPTS_PER_MESSAGE' /etc/mail/sendmail.mc > /dev/null 2>&1
  if [ $? = 0 ]; then
    /bin/mv /etc/mail/sendmail.mc /etc/mail/sendmail.mc.bxold
    /bin/mv /etc/mail/sendmail.cf /etc/mail/sendmail.cf.bxold
    /usr/sausalito/scripts/initSendmail.sh &>/dev/null || :
    echo 'Ran: /usr/sausalito/scripts/initSendmail.sh (#2)' >> /tmp/blueonyx-glue-post-install.log
  fi
fi

if [ $1 -eq 1 ]; then
  # Pretty please: Only on new installs, not updates!
  if [ -S /usr/sausalito/cced.socket ]; then
    # And only if CCEd is actually up!
    /usr/sausalito/constructor/base/email/syncEmailService.pl &>/dev/null || :
    echo 'Ran: /usr/sausalito/constructor/base/email/syncEmailService.pl' >> /tmp/blueonyx-glue-post-install.log
  fi
fi

# install BlueOnyx pgp key
/bin/rpm -q gpg-pubkey-5202f88b-491b00bc > /dev/null 2>&1
if [ $? = 1 ]; then
  /bin/rpm --import /usr/share/doc/blueonyx-release-510XR/RPM-GPG-KEY-NUSOL-5106R &>/dev/null || :
  echo 'Installed BlueOnyx RPM key' >> /tmp/blueonyx-glue-post-install.log
fi

# Run rest of externalized Post-Install commands:
/usr/sausalito/scripts/init.sh &>/dev/null || :
echo 'Ran external /usr/sausalito/scripts/init.sh to complete post-install' >> /tmp/blueonyx-glue-post-install.log

<end glue>
