msgid "twofactor_admin_title"
msgstr "Administración de autenticación de dos factores"

msgid "twofactor_admin_desc"
msgstr "Gestionar el estado 2FA de los usuarios. Ver quién tiene 2FA activado, desbloquear cuentas bloqueadas o restablecer 2FA para usuarios."

