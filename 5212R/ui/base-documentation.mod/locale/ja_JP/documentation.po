# -------------- upper-banner button -----------------------

msgid "manual"
msgstr "マニュアルの表示"

msgid "manual_help"
msgstr "このアイコンをクリックすると、マニュアルが表示されます。"

msgid "manualButton"
msgstr "マニュアルの表示"

msgid "manualButton_help"
msgstr "このアイコンをクリックすると、オンラインの製品マニュアルおよび参考資料を選んで表示できます。"


# ---------------- pop-up interface ---------------------

msgid "folder"
msgstr "製品マニュアル"

msgid "folderDescription"
msgstr "オンラインの製品マニュアルおよび参考資料の一覧。"

msgid "logout"
msgstr "閉じる"

msgid "logoutDescription"
msgstr "文書表示画面を閉じます。"

msgid "documentation"
msgstr "ユーザマニュアル"

msgid "documentationDescription"
msgstr "[[base-alpine.osName]] サーバのマニュアルを表示。"

msgid "documentation_acrobat_help"
msgstr "ここをクリックすると、アドビシステムズ社のウェブサイトから Adobe Acrobat Reader をダウンロードできます。"

msgid "documentation_acrobat"
msgstr "[[base-alpine.osName]] サーバのオンラインマニュアルを開くには、PDF ファイル (.pdf) を表示できるソフトウェア (Adobe Acrobat Reader など) が必要です。"

msgid "pdfDescription"
msgstr "文書名"

msgid "pdfDescription_help"
msgstr "オンラインマニュアルの文書名です。"

msgid "pdfSize"
msgstr "文書サイズ"

msgid "pdfSize_help"
msgstr "オンラインマニュアルは、サーバ上にローカルでホストされています。マニュアルを頻繁に参照する必要があれば、ブラウザのディスクキャッシュを 20MB 以上に設定することによりアクセス速度を向上できます。"

msgid "pdfAction"
msgstr "表示"

msgid "pdfAction_help"
msgstr "地球アイコンをクリックすると、マニュアルを表示またはダウンロードできます。"

msgid "openPdf"
msgstr "表示"

msgid "openPdf_help"
msgstr "PDF ファイル (.pdf) を表示するための Plug-in ユーティリティ (Adobe Acrobat Reader など) がブラウザにインストールされていれば、マニュアルは自動的に開きます。"

msgid "megabytes"
msgstr "MB"

msgid "pdfCountPlural"
msgstr "[[VAR.count]] 文書"

msgid "pdfCountSingular"
msgstr "[[VAR.count]] 文書"

msgid "manualPdfList"
msgstr "ユーザマニュアル"

