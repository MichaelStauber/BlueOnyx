#!/usr/bin/perl

# This is a wrapper that wraps around the PHP mail() function. 
# It logs some useful extra variables to /var/log/maillog.
# These give us a good indication about which PHP script is
# sending emails:

# Env values may contain shell metacharacters (e.g. Host header /
# mail() 5th parameter path). Never interpolate them into a single
# string passed to system() - that would invoke /bin/sh. Use list-form
# system() only (no shell).

$HTTP_HOST = defined $ENV{_HTTP_HOST} ? $ENV{_HTTP_HOST} : '';
$REMOTE_ADDR = defined $ENV{_REMOTE_ADDR} ? $ENV{_REMOTE_ADDR} : '';
$PWD = defined $ENV{PWD} ? $ENV{PWD} : '';
$SCRIPT_NAME = defined $ENV{_SCRIPT_NAME} ? $ENV{_SCRIPT_NAME} : '';
$UID = defined $ENV{SUID} ? $ENV{SUID} : '';
$OWNER = defined $ENV{_SOWNER} ? $ENV{_SOWNER} : '';

# If the AV-SPAM and Milter-GeoIP are installed, then we include the somewhat
# more sophisticated libraries of it to check if PHP scripts send more email
# than allowed for Vsites. If so, the sending of Email for scripts of that
# Vsite will be aborted.
if (-f "/home/solarspeed/milter-geoip/bin/libs/phpsendmail_include.pl") {
    require "/home/solarspeed/milter-geoip/bin/libs/phpsendmail_include.pl";
    $status = &mysql_logger();
    if ($status eq "FAIL") {
        exit(0);
    }
}

# Log the activity into /var/log/maillog with all the info we have gathered.
# Message is one argv to logger - content is not parsed by a shell.
$log_msg = "sendmail-wrapper-php: site=$HTTP_HOST, client=$REMOTE_ADDR, script=$PWD$SCRIPT_NAME, uid=$UID, user=$OWNER";
system('/usr/bin/logger', '-p', 'mail.info', $log_msg);

# Actually send the email by passing it to Sendmail.
# Same flags as before (-t -i) plus PHP mail() / sendmail_path argv.
# List form: no shell, so shell metacharacters in @ARGV are not executed.
system('/usr/sbin/sendmail', '-t', '-i', @ARGV);

