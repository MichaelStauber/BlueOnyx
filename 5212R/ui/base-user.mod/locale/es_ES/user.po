msgid "autoRespondStopDate"
msgstr "Fecha de finalización:"

msgid "autoRespondStopDate_help"
msgstr "Fecha y hora en que la respuesta automática (si está activado) deja de enviar mensajes de vacaciones. Si la fecha de inicio y parada son idénticos, mientras que la respuesta automática está activada, se ejecutará hasta que se apaga."

msgid "autoRespondStartTime"
msgstr "Hora de inicio:"

msgid "autoRespondStartTime_help"
msgstr "Momento en que la respuesta automática (si está activado) comienza a enviar mensajes de vacaciones."

msgid "autoRespondStoptTime"
msgstr "Tiempo de parada:"

msgid "autoRespondStoptTime_help"
msgstr "Momento en que la respuesta automática (si está activado) deja de enviar mensajes de vacaciones."

msgid "invalidVacationDate"
msgstr "Ha escrito una fecha de vacaciones válida. La fecha y la hora de parada no debe ser anterior a la fecha de inicio."

