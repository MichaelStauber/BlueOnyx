<begin glue>
# glue post-install

# Make sure that the Apache alias database ownership is setup properly.
if [ -f /etc/httpd/alias/cert8.db ]; then
	find /etc/httpd/alias -user root -name "*.db" -exec /bin/chgrp apache {} \;
	find /etc/httpd/alias -user root -name "*.db" -exec /bin/chmod g+r {} \;
fi

if [ $1 -gt 1 ]; then
  /usr/sausalito/handlers/base/apache/preview.pl -c
fi

# remove server.conf
if [ -f /etc/httpd/conf.d/server.conf ]; then
  /bin/rm -f /etc/httpd/conf.d/server.conf
fi

# While we are at it, delete the default CentOS welcome page:
if [ -f /etc/httpd/conf.d/welcome.conf ]; then
  /bin/rm -f /etc/httpd/conf.d/welcome.conf
fi

# The manual page needs to go as well:
if [ -f /etc/httpd/conf.d/manual.conf ]; then
  /bin/rm -f /etc/httpd/conf.d/manual.conf
fi

# Walk through /etc/httpd/conf/vhosts/site* and comment out the RewriteRule line that breaks SSL:
if [ -f "/etc/httpd/conf/vhosts/site1" ]; then
        sed -i -e 's/^#RewriteRule ^\/(.*)/RewriteRule ^\/(.*)/' /etc/httpd/conf/vhosts/site*
fi

# A lot of BX servers have ImageMagick installed, which in turn installs and activates the avahi-daemon.
# This daemon is not really needed and certainly should not be running. Hence we stop it and turn it off:
if [ -f /etc/avahi/avahi-daemon.conf ]; then
	systemctl disable avahi-daemon >/dev/null 2>&1 || :
	systemctl stop avahi-daemon --no-block >/dev/null 2>&1 || :
fi

# Fix login links in preview config:
if [ -f /etc/httpd/conf/vhosts/preview ]; then
  /bin/sed -i -e 's/login\.php/login/' /etc/httpd/conf/vhosts/preview
fi

# Make sure /etc/httpd/conf/mime.types is there. The RPM "mailcap" brings it aboard:
if [ ! -f /etc/httpd/conf/mime.types ]; then
  /bin/cp /etc/mime.types /etc/httpd/conf/mime.types
fi

# Run SSL_fixer.pl to enforce writing of updated SSL Vhost configs: (currently not in use)
#if [ -f /usr/sausalito/sbin/SSL_fixer.pl ]; then
#  /usr/sausalito/sbin/SSL_fixer.pl
#fi

for file in /etc/php-fpm-*.d/www.conf; do
    rpmnew="${file}.rpmnew"
    if [ -f "$rpmnew" ]; then
        cp -f "$rpmnew" "$file" || :
    fi
done

# One time conversion of PHP-FPM settings: (currently not in use)
#if [ $1 -gt 1 ]; then
#	/usr/sausalito/sbin/phptoggle.pl -fpm
#fi

# Rehash/Restart CCEd and Apache for good measure:
if [ -d /usr/sausalito/yumcce ];then
	touch /usr/sausalito/yumcce/restart
fi

if [ ! -f /etc/sysconfig/php-fpm ];then
	touch /etc/sysconfig/php-fpm
fi

if [ -f /usr/bin/systemctl ]; then

	# Copy our modified php-fpm.service over:
	cp /usr/sausalito/configs/systemd/php-fpm.service /usr/lib/systemd/system/php-fpm.service

	# Reload
	systemctl daemon-reload --no-block >/dev/null 2>&1 || :

	# Enable service php-fpm:
	systemctl enable php-fpm.service >/dev/null 2>&1 || :

	# Start service php-fpm:
  if [ $1 -gt 1 ] ; then
    systemctl condrestart php-fpm.service --no-block >/dev/null 2>&1 || :
    systemctl condrestart httpd --no-block >/dev/null 2>&1 || :
  fi
fi

