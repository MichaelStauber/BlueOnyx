<class name="System" namespace="Jailkit" version="1.0">

    <property 
        name="enabled" type="boolean" default="0"
        writeacl="ruleCapable(serverHttpd)"
    />

    <property 
        name="force_update" type="scalar" default=""
        writeacl="ruleCapable(serverHttpd)"
    />

</class>
