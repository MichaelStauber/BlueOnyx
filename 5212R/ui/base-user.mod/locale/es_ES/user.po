msgid "cantCreateAlterRoot"
msgstr "No se puede crear la cuenta de usuario root, [[VAR.root]]."

msgid "cantUpdateAlterRoot"
msgstr "No es posible sincronizar la contraseña de la cuenta de usuario root para la cuenta root, [[VAR.root]], para que coincida con la contraseña de [[VAR.name]] &#39;s cuenta."

msgid "emailDisabled"
msgstr "Desactivar Email del usuario"

