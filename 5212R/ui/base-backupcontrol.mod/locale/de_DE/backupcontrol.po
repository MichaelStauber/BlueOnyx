### GUI port and URIs:
#

msgid "GUI_PORT"
msgstr "GUI HTTPS-Port"

msgid "GUI_PORT_help"
msgstr "Geben Sie den HTTPS-Port für den Zugriff auf die GUI an. Der Standardport ist 81."

msgid "GUI_URLs"
msgstr "GUI-Aliase"

msgid "GUI_URLs_help"
msgstr "Geben Sie Apache-Aliase an, die zur GUI-Anmeldeseite umleiten. Dieses Feld darf nicht leer sein."

msgid "GUI_PORT_in_use"
msgstr "Der angegebene GUI-Port wird bereits von einem anderen Dienst verwendet. Bitte wählen Sie einen anderen Port."

msgid "GUI_URLs_minimum_fail"
msgstr "Es muss mindestens ein Apache-Alias angegeben werden, der zum GUI-Interface umleitet."
