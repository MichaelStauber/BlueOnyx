# strings for shell menu items
msgid "shellMenu"
msgstr "Server Access"

msgid "shellMenuDescription"
msgstr "Configure server access for GUI, shell access (SSH and Telnet) as well as file related services such as FTP, SFTP and SCP."

# server wide shell access page
msgid "shell"
msgstr "[[base-shell.shellMenu]]"

# ui extensions
msgid "shellName"
msgstr "Shell Access"

msgid "enableShell"
msgstr "Shell Access"

msgid "enableShell_help"
msgstr "Enable shell access to allow sufficiently privileged users to use services such as Telnet, SSH, SFTP or SCP."

msgid "userEnableShell"
msgstr "[[base-shell.enableShell]]"

msgid "userEnableShell_help"
msgstr "Enable shell access to allow the user to be able to connect to the server using services such as Telnet, SSH, SFTP or SCP."

msgid "shellIsEnabled"
msgstr "Shell Access"

msgid "shellIsEnabled_help"
msgstr "Shell access is enabled for this user."

# handler error messages
# user_shell.pl
msgid "cantEnableNoVsiteShell"
msgstr "Shell access cannot be enabled for this user, because the virtual site which they are a member of does not have shell access enabled."

# site shell menus
msgid "siteshell"
msgstr "[[base-shell.shellMenu]]"

msgid "siteshell_help"
msgstr "Configure access for GUI, shell access (SSH and Telnet) as well as file related services such as FTP, SFTP and SCP for this site."

msgid "siteShellSettings"
msgstr "Shell & FTP Settings for [[VAR.fqdn]]"

msgid "cap_serverShell"
msgstr "Shell Settings"

