msgstr "Radicale CalDAV/CardDAV Server"

msgid "amDetailsTitle"
msgstr "Radicale CalDAV/CardDAV Server Details"

msgid "amStatusOK"
msgstr "The Radicale CalDAV/CardDAV server is operating normally."

msgid "amNotAccepting"
msgstr "The Radicale CalDAV/CardDAV server is not running and could not be restarted. Try turning the Radicale CalDAV/CardDAV server off then on again to see if this corrects the problem."

