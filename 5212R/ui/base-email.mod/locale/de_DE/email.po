msgid "activated_help"
msgstr "Hier können Sie sehen on ein Blacklist-Eintrag aktiv ist oder nicht."

msgid "blacklistHostExists_error"
msgstr "Diese Blackliste wurde bereits hinzugefügt. Bitte ändern Sie den Hostnamen auf etwas anderes."

msgid "blacklistRemoveEntry"
msgstr "Sind Sie sicher, dass Sie die Blacklisten-Dienst [[VAR.blacklistHost]] löschen möchten?"

msgid "blacklistHostField"
