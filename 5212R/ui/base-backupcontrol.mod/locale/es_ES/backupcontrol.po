### GUI port and URIs:
#

msgid "GUI_PORT"
msgstr "Puerto HTTPS de GUI"

msgid "GUI_PORT_help"
msgstr "Especifica el puerto HTTPS para acceder a la GUI. El puerto predeterminado es el 81."

msgid "GUI_URLs"
msgstr "Alias de GUI"

msgid "GUI_URLs_help"
msgstr "Especifica alias de Apache que redirigen a la página de inicio de sesión de la GUI. Este campo no puede estar vacío."

msgid "GUI_PORT_in_use"
msgstr "El puerto de GUI especificado ya está en uso por otro servicio. Por favor, selecciona otro puerto."

msgid "GUI_URLs_minimum_fail"
msgstr "Se requiere al menos un alias de Apache que redirija a la interfaz de la GUI."
